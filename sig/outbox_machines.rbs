module OutboxMachines
  VERSION: String

  # Private validating hooks behind the Data values.
  def self.__retry: (untyped at) -> void
  def self.__failure: (untyped disposition) -> void
  def self.__claimed: (untyped id, untyped attempt, untyped lease_expires) -> void
  def self.__expired: (untyped id, untyped attempt, untyped disposition) -> void
  def self.__sweep: (untyped expired, untyped scanned, untyped pass) -> void
  def self.__entry: (untyped id, untyped state, untyped attempts, untyped attempt, untyped available_at) -> void
  CAPACITY: Integer

  type state = :pending | :claimed | :confirmed | :dead

  # The core's `Disposition`: Retry(at), or :dead.
  type disposition = Retry | :dead

  # The core's `Disposition::Retry(at)`: pending again, claimable at or after
  # the instant `at`, in nanoseconds. TypeError for a non-Integer, RangeError
  # past what a Duration holds or negative.
  class Retry < Data
    attr_reader at: Integer
    def self.new: (Integer at) -> Retry
                | (at: Integer) -> Retry
  end

  # The core's `Failure::Failed(disposition)`: the live attempt is over.
  # RangeError for a Symbol other than :dead, TypeError for anything else
  # that is not a Retry (also for AlreadyFailed).
  class Failed < Data
    attr_reader disposition: disposition
    def self.new: (disposition disposition) -> Failed
                | (disposition: disposition) -> Failed
  end

  # The core's `Failure::AlreadyFailed(disposition)`: an idempotent repeat,
  # same attempt and same retry_after, carrying the standing disposition;
  # nothing changed.
  class AlreadyFailed < Data
    attr_reader disposition: disposition
    def self.new: (disposition disposition) -> AlreadyFailed
                | (disposition: disposition) -> AlreadyFailed
  end

  # Mirrors the core's `Entry`; `new` is held to `Entry::new` (RangeError
  # when attempt is not nil exactly when attempts is 0, has sequence zero, or
  # a non-pending record has no attempt; TypeError for a wrong type).
  class Entry < Data
    attr_reader id: Integer
    attr_reader state: state
    # Claims issued to this record so far; it dies at max_attempts.
    attr_reader attempts: Integer
    # Identity of the latest attempt, nil until the record is first claimed.
    attr_reader attempt: Integer?
    # Earliest instant, in nanoseconds, a pending record may be claimed.
    attr_reader available_at: Integer
    def self.new: (Integer id, state state, Integer attempts, Integer? attempt, Integer available_at) -> Entry
                | (id: Integer, state: state, attempts: Integer, attempt: Integer?, available_at: Integer) -> Entry
  end

  # Mirrors the core's `Claimed`; `new` is held to `Claimed::new` (RangeError
  # for attempt sequence zero or lease_expires 0; TypeError for a wrong type).
  class Claimed < Data
    attr_reader id: Integer
    # Identity of the attempt: issued once per outbox and never reissued. It
    # carries the outbox's scope in its top 16 bits above a sequence starting
    # at 1, so scope zero issues 1, 2, 3. Not the record's attempt count.
    attr_reader attempt: Integer
    # Instant, in nanoseconds, from which expire_claims may reap the lease.
    attr_reader lease_expires: Integer
    def self.new: (Integer id, Integer attempt, Integer lease_expires) -> Claimed
                | (id: Integer, attempt: Integer, lease_expires: Integer) -> Claimed
    # The scope of the outbox that issued this attempt.
    def scope: () -> Integer
  end

  # Mirrors the core's `Expired`; `new` is held to `Expired::new` (RangeError
  # for attempt sequence zero; the disposition is checked as Failed's).
  class Expired < Data
    attr_reader id: Integer
    attr_reader attempt: Integer
    attr_reader disposition: disposition
    def self.new: (Integer id, Integer attempt, disposition disposition) -> Expired
                | (id: Integer, attempt: Integer, disposition: disposition) -> Expired
    # The scope of the outbox that issued the reaped attempt.
    def scope: () -> Integer
  end

  # The core's `Pass`: :complete once the cursor finished a full pass over
  # every slot, cumulatively across calls; :partial until then.
  type pass = :partial | :complete

  # Mirrors the core's `Sweep`. `expired` holds the reaped claims themselves,
  # where the core reports how many it wrote to the caller's buffer. `new`
  # keeps a frozen copy of the Array; RangeError when it holds more than
  # `scanned` or `pass` is another Symbol, TypeError for a non-Expired element
  # or a non-Symbol pass.
  class Sweep < Data
    attr_reader expired: Array[Expired]
    attr_reader scanned: Integer
    attr_reader pass: pass
    def self.new: (Array[Expired] expired, Integer scanned, pass pass) -> Sweep
                | (expired: Array[Expired], scanned: Integer, pass: pass) -> Sweep
  end

  class Outbox
    # Every refusal symbol, one per core `Refusal` variant, no catch-all. A
    # refused call changed nothing. Each method below lists exactly the ones
    # it can answer.
    type refusal = :unknown | :stale | :not_terminal | :time_regression | :invalid_duration | :exhausted | :full
                 | :mismatch

    # Every instant (`now`, `lease_expires`, a retry `at`) and every span
    # (`lease`, `retry_after`) is Integer nanoseconds of the caller's monotonic
    # clock. A non-Integer raises TypeError; negative or past 2**64-1 raises
    # RangeError.

    # An empty outbox in scope zero.
    def self.new: (Integer max_attempts) -> Outbox
    # An empty outbox whose attempt identities carry `scope`, an Integer in
    # 0..65_535 (TypeError for a non-Integer, RangeError outside the range).
    # An attempt from an outbox of another scope is always :stale.
    def self.with_scope: (Integer max_attempts, Integer scope) -> Outbox
    # An empty outbox of `scope` that continues the attempt sequence after
    # `issued` identities, the count a previous incarnation read from #issued:
    # the next claim carries sequence issued + 1. `issued` is an Integer in
    # 0..2**48-1 (TypeError for a non-Integer, RangeError outside the range;
    # the core answers None there). resumed(max_attempts, scope, 0) is
    # with_scope(max_attempts, scope).
    def self.resumed: (Integer max_attempts, Integer scope, Integer issued) -> Outbox
    def scope: () -> Integer
    # How many attempt identities this outbox has issued; also the sequence
    # number of the latest one. Save it to restart with Outbox.resumed.
    def issued: () -> Integer
    # Private: what Claimed#scope and Expired#scope read. RangeError for an
    # attempt of sequence zero.
    def self.__scope_of: (Integer attempt) -> Integer
    def capacity: () -> Integer
    def max_attempts: () -> Integer
    def size: () -> Integer
    def empty?: () -> bool
    # TypeError for a non-Symbol, RangeError for a Symbol naming no state.
    def count: (state state) -> Integer
    # The record with this id, or nil. Never refuses.
    def get: (Integer id) -> Entry?

    # Honoured: :enqueued (records now), or :duplicate for an id that is
    # already present (records nothing).
    def enqueue: (Integer id, Integer now) -> (:enqueued | :duplicate | :time_regression | :full)

    # Honoured: a Claimed, or nil when nothing is due; both record now.
    # :exhausted means a
    # record is due but the outbox has issued every attempt identity of its
    # scope, 2**48-1 of them; it cannot be reached in practice.
    def claim: (Integer now, Integer lease) -> (Claimed | nil | :time_regression | :invalid_duration | :exhausted)

    # Honoured: :confirmed, or :already_confirmed when this same attempt
    # already confirmed the record (a repeat that changes nothing). :stale
    # for an attempt this outbox never issued (another scope, or a sequence
    # it has not reached) comes first, whatever the id. :unknown is an id
    # the outbox does not hold, forgotten records included; :stale is
    # an attempt that is neither the live one nor the confirming one, which
    # includes an attempt of an earlier record that carried the same id.
    def confirm: (Integer id, Integer attempt) -> (:confirmed | :already_confirmed | :unknown | :stale)

    # Honoured: a Failed (records now), or an AlreadyFailed (records nothing) when `fail` already ended this
    # same attempt with this same retry_after and no claim followed (a repeat
    # that changes nothing and answers the standing disposition; `now` may
    # differ). The disposition is a Retry carrying the instant the record is
    # claimable again, or :dead once max_attempts claims are spent. :stale
    # covers a superseded, confirmed or reaped attempt, one of an earlier
    # record that carried the same id, and one this outbox never issued
    # (another scope, or a sequence it has not reached; answered first,
    # whatever the id); :mismatch is a repeat whose retry_after
    # is not the one recorded.
    def fail: (Integer id, Integer attempt, Integer now, Integer retry_after)
            -> (Failed | AlreadyFailed | :unknown | :stale | :time_regression | :invalid_duration | :mismatch)

    # Honoured: a Sweep of at most 16 Expired values, also when it reaped
    # none; it always records now. A max_scan past what the platform's usize
    # holds raises RangeError rather than being narrowed.
    def expire_claims: (Integer now, Integer max_scan) -> (Sweep | :time_regression)

    # Honoured: :forgotten, or :not_held for an id the outbox does not hold (a
    # repeat that changes nothing). Never answers :unknown.
    def forget: (Integer id) -> (:forgotten | :not_held | :not_terminal)
  end
end
